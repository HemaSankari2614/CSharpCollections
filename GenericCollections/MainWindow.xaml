<Window x:Class="GenericCollections.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GenericCollections"
        mc:Ignorable="d"
        Title="Generic Collection Demo"
        Height="600" Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#FFF0F5">

    <Grid Margin="20">
        <Border Background="White"
                CornerRadius="15"
                Padding="25">

            <StackPanel>
                <TextBlock Text="Generic Collection - Employee Manager"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="#C2185B"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Employee ID"/>
                <TextBox x:Name="txtId"
                         Height="35"
                         Margin="0,5,0,12"/>

                <TextBlock Text="Employee Name"/>
                <TextBox x:Name="txtName"
                         Height="35"
                         Margin="0,5,0,15"/>

                <WrapPanel HorizontalAlignment="Center"
                           Margin="0,0,0,15">
                    <Button Content="Add Employee"
                            Width="140"
                            Height="40"
                            Margin="5"
                            Background="DarkKhaki"
                            Foreground="White"
                            Click="Add_Click"/>

                    <Button Content="Remove Employee"
                            Width="155"
                            Height="40"
                            Margin="5"
                            Background="#AD1457"
                            Foreground="White"
                            Click="Remove_Click"/>

                    <Button Content="Clear"
                            Width="90"
                            Height="40"
                            Margin="5"
                            Click="Clear_Click"/>
                </WrapPanel>

                <TextBlock Text="Employee List"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#C2185B"
                           Margin="0,5,0,10"/>

                <ListView x:Name="lvEmployees"
                          Height="250">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID"
                                            DisplayMemberBinding="{Binding Id}"
                                            Width="100"/>
                            <GridViewColumn Header="Employee Name"
                                            DisplayMemberBinding="{Binding Name}"
                                            Width="300"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock x:Name="txtCount"
                           Text="Total Employees: 0"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#C2185B"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
