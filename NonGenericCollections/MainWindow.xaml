<Window x:Class="NonGenericCollections.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NonGenericCollections"
        mc:Ignorable="d"
        Title="Non-Generic Collections"
        Height="700" Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#FFF0F5">

    <Grid Margin="20">
        <Border Background="White"
                CornerRadius="15"
                Padding="25">

            <StackPanel>
                <TextBlock Text="Non-Generic Collection Demo"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#C2185B"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Employee ID"/>
                <TextBox x:Name="txtId"
                         Height="35"
                         Margin="0,5,0,12"/>

                <TextBlock Text="Employee Name"/>
                <TextBox x:Name="txtName"
                         Height="35"
                         Margin="0,5,0,12"/>

                <TextBlock Text="Salary"/>
                <TextBox x:Name="txtSalary"
                         Height="35"
                         Margin="0,5,0,18"/>

                <WrapPanel HorizontalAlignment="Center"
                           Margin="0,0,0,15">

                    <Button Content="Add Employee"
                            Width="130" Height="40"
                            Margin="5"
                            Background="DarkMagenta"
                            Foreground="White"
                            Click="Add_Click"/>

                    <Button Content="Remove Selected"
                            Width="145" Height="40"
                            Margin="5"
                            Background="#AD1457"
                            Foreground="White"
                            Click="Remove_Click"/>

                    <Button Content="Clear All"
                            Width="100" Height="40"
                            Margin="5"
                            Click="Clear_Click"/>
                </WrapPanel>

                <TextBlock Text="Employee Records"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#C2185B"
                           Margin="0,0,0,10"/>

                <ListBox x:Name="lstEmployees"
                         Height="220"
                         FontSize="14"/>

                <TextBlock x:Name="txtCount"
                           Text="Total Records: 0"
                           FontWeight="Bold"
                           Foreground="#C2185B"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

